<figure class="diagram">
  <svg viewBox="0 0 520 310" role="img" aria-labelledby="perceptron-diagram-title">
    <title id="perceptron-diagram-title">一套感知机框架支撑五个任务：分词、词性、命名实体、人名、拼音音节切分</title>

    <path class="flow" d="M260 140 L260 46" />
    <path class="flow" d="M260 140 L90 96" />
    <path class="flow" d="M260 140 L430 96" />
    <path class="flow" d="M260 140 L90 232" />
    <path class="flow" d="M260 140 L430 232" />

    <rect class="box-accent" x="155" y="104" width="210" height="72" rx="14" />
    <text class="hub-t" x="260" y="138" text-anchor="middle">感知机框架</text>
    <text class="hub-sm" x="260" y="159" text-anchor="middle">org.zaprt.nlp.perceptron</text>

    <rect class="pill" x="200" y="25" width="120" height="42" rx="21" />
    <text class="t" x="260" y="51" text-anchor="middle">中文分词 CWS</text>

    <rect class="pill" x="30" y="75" width="120" height="42" rx="21" />
    <text class="t" x="90" y="101" text-anchor="middle">词性标注 POS</text>

    <rect class="pill" x="370" y="75" width="120" height="42" rx="21" />
    <text class="t" x="430" y="101" text-anchor="middle">命名实体 NER</text>

    <rect class="pill" x="30" y="211" width="120" height="42" rx="21" />
    <text class="t" x="90" y="237" text-anchor="middle">人名识别</text>

    <rect class="pill" x="370" y="211" width="120" height="42" rx="21" />
    <text class="t" x="430" y="237" text-anchor="middle">拼音音节切分</text>

    <text class="muted" x="260" y="282" text-anchor="middle">五个任务共用同一套框架，可以用自己的语料训练替换默认模型</text>
    <text class="muted" x="260" y="298" text-anchor="middle">字符级任务直接继承 CharBasedPerceptronInstance</text>
  </svg>
</figure>

<style>
  .diagram {
    margin: 0;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--sl-font);
  }

  .pill {
    fill: var(--sl-color-black);
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.5;
  }

  .box-accent {
    fill: var(--sl-color-accent-low);
    stroke: var(--sl-color-accent);
    stroke-width: 1.5;
  }

  .flow {
    fill: none;
    stroke: var(--sl-color-accent);
    stroke-width: 1.75;
    opacity: 0.55;
  }

  .t {
    fill: currentColor;
    font-size: 13px;
  }

  .hub-t {
    fill: var(--sl-color-accent-high);
    font-size: 15px;
    font-weight: 600;
  }

  .hub-sm {
    fill: var(--sl-color-accent-high);
    opacity: 0.75;
    font-size: 10.5px;
  }

  .muted {
    fill: currentColor;
    opacity: 0.65;
    font-size: 11.5px;
  }
</style>