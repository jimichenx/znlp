---
/**
 * 五个任务共用 dev.znlp.perceptron。
 */
const tasks = [
  ['中文分词', 'CWS'],
  ['词性标注', 'POS'],
  ['命名实体', 'NER'],
  ['人名识别', ''],
  ['拼音音节切分', ''],
];
---

<figure class="hub-diagram">
  <p class="sr" id="perceptron-diagram-title">一套感知机框架支撑五个任务：分词、词性、命名实体、人名、拼音音节切分</p>

  <div class="layout">
    <div class="core">
      <strong>感知机框架</strong>
      <span>dev.znlp.perceptron</span>
    </div>
    <ul>
      {
        tasks.map(([name, code]) => (
          <li>
            {name}
            {code && <em>{code}</em>}
          </li>
        ))
      }
    </ul>
    <p>五个任务共用这一套框架，可以用自己的语料替换默认模型。字符级任务继承 CharBasedPerceptronInstance。</p>
  </div>
</figure>

<style is:global>
  .hub-diagram {
    container-type: inline-size;
    margin: 0;
  }

  .hub-diagram .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  .hub-diagram .layout {
    display: grid;
    gap: 0.85rem;
  }

  .hub-diagram .core {
    display: grid;
    gap: 0.2rem;
    align-content: center;
    min-height: 6.5rem;
    padding: 1rem 1.05rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--sl-color-accent) 16%, var(--sl-color-black));
  }

  .hub-diagram .core strong {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
  }

  .hub-diagram .core span {
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    color: var(--sl-color-accent);
  }

  .hub-diagram ul {
    display: grid;
    gap: 0.45rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hub-diagram li {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-left: 1.15rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-black);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .hub-diagram li::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -1.15rem;
    width: 1.15rem;
    height: 2px;
    background: var(--sl-color-accent);
  }

  .hub-diagram li em {
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    font-style: normal;
    font-weight: 600;
    color: var(--sl-color-accent);
  }

  .hub-diagram p {
    margin: 0.8rem 0 0;
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--sl-color-gray-3);
  }

  @container (min-width: 32rem) {
    .hub-diagram .layout {
      grid-template-columns: minmax(8.5rem, 11.5rem) minmax(0, 1fr);
      column-gap: 1.35rem;
      align-items: center;
    }

    .hub-diagram ul {
      grid-column: 2;
      grid-row: 1;
      margin-top: 0;
    }

    .hub-diagram .core {
      grid-column: 1;
      grid-row: 1;
      align-self: stretch;
    }

    .hub-diagram p {
      grid-column: 1 / -1;
    }
  }
</style>
