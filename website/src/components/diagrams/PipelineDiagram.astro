---
/**
 * 分词两条路径。阶段和约束与 SegmentRecipe 的说明一致。
 */
const standard = [
  ['输入文本', '字符串 · char[]'],
  ['候选铺图', '核心词典 · 规则'],
  ['Viterbi 选路', '二元语法'],
  ['人名 · 词性', '可独立开关'],
  ['Token 流', '流式 · 列表'],
];

const perceptron = [
  ['输入文本', '字符串 · char[]'],
  ['CWS 边界判定', '感知机'],
  ['原子补洞', ''],
  ['Token 流', '流式 · 列表'],
];

const after = ['用户词典：选路后合并', '纠错词典：优先级更高', 'indexTerms()：附索引子词'];
---

<figure class="pipe-diagram">
  <p class="sr" id="pipeline-diagram-title">分词流水线：standard 走词典与 Viterbi，perceptron 走线性边界判定</p>

  <section class="lane">
    <header>
      <span>默认路径</span>
      <b>SegmentRecipe.standard()</b>
    </header>
    <ol class="steps">
      {
        standard.map(([name, detail]) => (
          <li>
            <strong>{name}</strong>
            {detail && <small>{detail}</small>}
          </li>
        ))
      }
    </ol>
  </section>

  <section class="lane alt">
    <header>
      <span>线性路径</span>
      <b>SegmentRecipe.perceptron()</b>
    </header>
    <ol class="steps">
      {
        perceptron.map(([name, detail]) => (
          <li>
            <strong>{name}</strong>
            {detail && <small>{detail}</small>}
          </li>
        ))
      }
    </ol>
    <p class="aside">不跑二元语法，也不经 Viterbi 选路</p>
  </section>

  <ul class="after">
    {after.map((item) => <li>{item}</li>)}
  </ul>
  <p class="foot">build() 一次。PipelineSegmenter 线程安全，可作单例复用。</p>
</figure>

<style is:global>
  .pipe-diagram {
    container-type: inline-size;
    margin: 0;
  }

  .pipe-diagram .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  .pipe-diagram .lane + .lane {
    margin-top: 0.9rem;
  }

  .pipe-diagram header {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    margin-bottom: 0.55rem;
  }

  .pipe-diagram header span {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--sl-color-accent);
  }

  .pipe-diagram header b {
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .pipe-diagram .steps {
    display: flex;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pipe-diagram .steps li {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    padding: 0.55rem 0.45rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 55%, var(--sl-color-gray-5));
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--sl-color-accent) 14%, var(--sl-color-black));
    text-align: center;
  }

  .pipe-diagram .alt .steps li {
    border-color: var(--sl-color-gray-5);
    background: var(--sl-color-black);
  }

  .pipe-diagram .steps li strong {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--sl-color-white);
  }

  .pipe-diagram .steps li small {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.68rem;
    line-height: 1.35;
    color: var(--sl-color-gray-3);
  }

  .pipe-diagram .steps li + li::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -0.85rem;
    width: 0.85rem;
    height: 2px;
    background: var(--sl-color-accent);
  }

  .pipe-diagram .steps li + li::after {
    content: '';
    position: absolute;
    top: calc(50% - 3px);
    left: -0.28rem;
    border: 3.5px solid transparent;
    border-left: 5px solid var(--sl-color-accent);
  }

  .pipe-diagram .aside,
  .pipe-diagram .foot {
    margin: 0.55rem 0 0;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }

  .pipe-diagram .after {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
  }

  .pipe-diagram .after li {
    padding: 0.28rem 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--sl-color-black);
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--sl-color-gray-2);
  }

  @container (max-width: 34rem) {
    .pipe-diagram .steps {
      flex-direction: column;
      gap: 0.55rem;
    }

    .pipe-diagram .steps li {
      text-align: left;
      padding-inline: 0.75rem;
    }

    .pipe-diagram .steps li + li::before {
      top: -0.55rem;
      left: 1.15rem;
      width: 2px;
      height: 0.55rem;
    }

    .pipe-diagram .steps li + li::after {
      top: -0.28rem;
      left: calc(1.15rem - 2.5px);
      border: 3.5px solid transparent;
      border-top: 5px solid var(--sl-color-accent);
    }
  }
</style>
